# Repo công khai CHỈ chứa trang tra cứu (app/index.html).
# Mọi thứ khác (sách PDF, ghi âm, ảnh slide, dữ liệu có nghĩa chép từ sách/web, file trung gian, script)
# chỉ để trên máy vì có bản quyền hoặc là lời của người khác. Muốn thêm file nào thì mở thêm dòng "!" có chủ ý.
/*
!/.gitignore
!/app/
/app/*
!/app/index.html
# Bản chia sẻ công khai (GitHub Pages phục vụ thư mục docs/): trang + dữ liệu KHÔNG có chữ chép từ sách/web,
# tạo bằng scripts/build_share.py (có bước kiểm chặn chữ sách lọt vào).
!/docs/
/docs/*
!/docs/index.html
!/docs/data.js
# Widget iPhone (Scriptable): gói dữ liệu nhỏ lấy từ bản chia sẻ, script widget, trang hướng dẫn cài
!/docs/widget.json
!/docs/widget.html
!/docs/widget-kho-tuc-ngu.js
